# 🔐 Password Strength Analyzer

def check_password(password):
    # Check each password criterion

    length_check = len(password) >= 8

    uppercase_check = False
    lowercase_check = False
    digit_check = False
    special_check = False
    space_check = " " not in password

    # Check every character in the password
    for character in password:

        if character.isupper():
            uppercase_check = True

        elif character.islower():
            lowercase_check = True

        elif character.isdigit():
            digit_check = True

        elif not character.isalnum() and character != " ":
            special_check = True

    # Count how many criteria are satisfied
    score = sum([
        length_check,
        uppercase_check,
        lowercase_check,
        digit_check,
        special_check,
        space_check
    ])

    # Decide overall password strength
    if score == 6:
        strength = "💪 Strong"
    elif score >= 4:
        strength = "🙂 Medium"
    else:
        strength = "⚠️ Weak"

    # Display the results
    print("\n🔐 Password Strength Analysis")
    print("--------------------------")

    print("📏 Length (minimum 8 characters):", "✅ Passed" if length_check else "❌ Failed")
    print("🔠 Uppercase letter:", "✅ Passed" if uppercase_check else "❌ Failed")
    print("🔡 Lowercase letter:", "✅ Passed" if lowercase_check else "❌ Failed")
    print("🔢 Digit:", "✅ Passed" if digit_check else "❌ Failed")
    print("🔣 Special character:", "✅ Passed" if special_check else "❌ Failed")
    print("🚫 No spaces:", "✅ Passed" if space_check else "❌ Failed")

    print("\n🏆 Overall Password Strength:", strength)

    # Display criteria that are not satisfied
    if score < 6:
        print("\n⚠️ Criteria not satisfied:")

        if not length_check:
            print("❌ Password must contain at least 8 characters.")

        if not uppercase_check:
            print("❌ Password must contain at least one uppercase letter.")

        if not lowercase_check:
            print("❌ Password must contain at least one lowercase letter.")

        if not digit_check:
            print("❌ Password must contain at least one digit.")

        if not special_check:
            print("❌ Password must contain at least one special character.")

        if not space_check:
            print("❌ Password should not contain spaces.")


# Main program

import getpass

password = getpass.getpass("🔑 Enter your password: ")

check_password(password) 